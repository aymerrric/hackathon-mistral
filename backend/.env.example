# Copy to .env and fill in. Loaded by app/config.py (pydantic-settings).

DATABASE_URL=postgresql+psycopg://calltree:calltree@localhost:5432/calltree

# Mistral API key — used for tree generation, call analysis (chat models)
# and speech-to-text (Voxtral).
MISTRAL_API_KEY=your-key-here

# Chat model for tree generation and call judging.
MISTRAL_CHAT_MODEL=mistral-large-latest
# Transcription model.
MISTRAL_AUDIO_MODEL=voxtral-mini-latest

# Where uploaded audio files are stored on disk.
MEDIA_DIR=./media

# --- Live voice agent (web Voice tab + Twilio phone calls) ---------------
# Realtime speech-to-text model (WebSocket streaming).
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
# Text-to-speech model + preset voice (see the Voices API for other names).
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_TTS_VOICE=Jane - Neutral
# Transcription lag target (multiple of 80, 80-1200) and the silence gap
# (ms without new words) that ends a caller turn.
VOICE_STREAMING_DELAY_MS=480
VOICE_TURN_SILENCE_MS=900

# Comma-separated origins allowed by CORS (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
